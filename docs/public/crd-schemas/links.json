{
  "version": 1,
  "kinds": {
    "AngosIdentity": {
      "references": [
        {
          "path": "spec.adoptSecretRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.instanceRef",
          "to": [
            {
              "group": "angos.weebo.io",
              "kind": "AngosLocalInstance"
            }
          ]
        }
      ],
      "produces": [
        {
          "kind": {
            "group": "",
            "kind": "Secret"
          },
          "each": "spec.secretTargets[]",
          "name": [
            "name"
          ],
          "namespace": "namespace",
          "keyNames": [
            "username",
            "password",
            ".dockerconfigjson"
          ],
          "unless": {
            "path": "backend",
            "equals": "vault"
          }
        }
      ]
    },
    "AngosLocalInstance": {
      "references": [
        {
          "path": "spec.auth.oidc[].audienceFrom",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.auth.oidc[].issuerFrom",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.auth.oidc[].tls.ca.configMapKeyRef",
          "to": [
            {
              "group": "",
              "kind": "ConfigMap"
            }
          ]
        },
        {
          "path": "spec.auth.oidc[].tls.ca.secretKeyRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.auth.tokenService.keySecretRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.auth.webhooks[].bearerTokenSecretRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.auth.webhooks[].tls.ca.configMapKeyRef",
          "to": [
            {
              "group": "",
              "kind": "ConfigMap"
            }
          ]
        },
        {
          "path": "spec.auth.webhooks[].tls.ca.secretKeyRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.cache.redis.urlSecretRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.eventWebhooks[].tls.ca.configMapKeyRef",
          "to": [
            {
              "group": "",
              "kind": "ConfigMap"
            }
          ]
        },
        {
          "path": "spec.eventWebhooks[].tls.ca.secretKeyRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.eventWebhooks[].tokenSecretRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.scan.tls.ca.configMapKeyRef",
          "to": [
            {
              "group": "",
              "kind": "ConfigMap"
            }
          ]
        },
        {
          "path": "spec.scan.tls.ca.secretKeyRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.scan.tokenSecretRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.server.tls.clientCA",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.ui.oidc.clientIdFrom",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        }
      ],
      "produces": []
    },
    "AngosMaintenance": {
      "references": [
        {
          "path": "spec.instanceRef",
          "to": [
            {
              "group": "angos.weebo.io",
              "kind": "AngosLocalInstance"
            }
          ]
        }
      ],
      "produces": []
    },
    "AngosRepository": {
      "references": [
        {
          "path": "spec.instanceRef",
          "to": [
            {
              "group": "angos.weebo.io",
              "kind": "AngosLocalInstance"
            }
          ]
        }
      ],
      "produces": []
    }
  }
}
