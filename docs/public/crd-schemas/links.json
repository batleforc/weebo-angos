{
  "version": 1,
  "kinds": {
    "AngosIdentity": {
      "references": [
        {
          "path": "spec.adoptSecretRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.instanceRef",
          "to": [
            {
              "group": "angos.weebo.io",
              "kind": "AngosLocalInstance"
            }
          ]
        }
      ],
      "produces": [
        {
          "kind": {
            "group": "schematic.weebo.io",
            "kind": "DnsName"
          },
          "each": "spec.registryHost",
          "name": [
            "."
          ]
        },
        {
          "kind": {
            "group": "",
            "kind": "Secret"
          },
          "each": "spec.secretTargets[]",
          "name": [
            "name"
          ],
          "namespace": "namespace",
          "keyNames": [
            "username",
            "password",
            ".dockerconfigjson"
          ],
          "unless": {
            "path": "backend",
            "equals": "vault"
          }
        }
      ]
    },
    "AngosLocalInstance": {
      "references": [
